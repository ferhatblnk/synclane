<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SyncLane.Cli</RootNamespace>
    <AssemblyName>SyncLane.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>synclane</ToolCommandName>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IsPackable>true</IsPackable>
    <PackageId>SyncLane.Cli</PackageId>
    <Description>The synclane command: turns a working curl into a SyncLane recipe by looking at a real answer, and runs a recipe for two pages without a database.</Description>
    <PackageTags>sync;http;rest;api;recipe;curl;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncLane.Http\SyncLane.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SyncLane.Tests" />
  </ItemGroup>

</Project>
