<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SyncLane.Cli</RootNamespace>
    <AssemblyName>SyncLane.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>synclane</ToolCommandName>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IsPackable>true</IsPackable>
    <PackageId>SyncLane.Cli</PackageId>
    <Description>The synclane command: turns a working curl into a SyncLane recipe by looking at a real answer, runs a recipe for two pages without a database, and serves both to an AI assistant over MCP.</Description>
    <PackageTags>sync;http;rest;api;recipe;curl;cli;mcp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncLane.Http\SyncLane.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.1" />
  </ItemGroup>

  <!-- What 'synclane mcp' gives an AI assistant to read: the recipe guide and the error catalog, as they are in docs. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\recipes.md" LogicalName="SyncLane.Cli.recipes.md" />
    <EmbeddedResource Include="..\..\docs\errors.md" LogicalName="SyncLane.Cli.errors.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SyncLane.Tests" />
  </ItemGroup>

</Project>
