<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SyncLane</RootNamespace>
    <AssemblyName>SyncLane</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>SyncLane</PackageId>
    <Authors>The SyncLane Authors</Authors>
    <Description>A small job scheduler for syncing data from other people's APIs. One PostgreSQL table holds every job with its window, cursor, attempts and error; jobs of one account run in order while accounts run side by side.</Description>
    <PackageTags>jobs;scheduler;queue;postgres;sync;backfill;background</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ferhatblnk/synclane</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ferhatblnk/synclane</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SyncLane.Tests" />
  </ItemGroup>

</Project>
