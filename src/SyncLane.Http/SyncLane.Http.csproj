<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SyncLane.Http</RootNamespace>
    <AssemblyName>SyncLane.Http</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>SyncLane.Http</PackageId>
    <Description>Runs SyncLane jobs from a recipe instead of a hand-written handler: the request, how the job's window goes into it, where the records are in the answer, how to page and how to authenticate.</Description>
    <PackageTags>sync;http;rest;api;integration;recipe;pagination;postgres</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncLane\SyncLane.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SyncLane.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated from the recipe types by RecipeSchemaTests; see CLAUDE.md. -->
    <EmbeddedResource Include="..\..\schemas\recipe.schema.json" LogicalName="SyncLane.Http.recipe.schema.json" />
  </ItemGroup>
</Project>
