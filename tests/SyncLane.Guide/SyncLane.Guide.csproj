<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The C# examples of docs/integrating.md, as an application would hold them, compiled with the solution. The types
    the guide takes from the application (its DbContext, API client, repositories, test helpers) are stand-ins in
    StandIns.cs. ConventionTests checks that every example of the guide appears here unchanged.
  -->
  <PropertyGroup>
    <RootNamespace>GuideExamples</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SyncLane\SyncLane.csproj" />
    <ProjectReference Include="..\..\src\SyncLane.Http\SyncLane.Http.csproj" />
    <ProjectReference Include="..\..\src\SyncLane.AspNetCore\SyncLane.AspNetCore.csproj" />
  </ItemGroup>

  <!-- The namespaces step 1 of the guide names, and nothing else of SyncLane's. -->
  <ItemGroup>
    <Using Include="SyncLane" />
    <Using Include="System.Text.Json" />
    <Using Include="SyncLane.Http" />
    <Using Include="SyncLane.AspNetCore" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
