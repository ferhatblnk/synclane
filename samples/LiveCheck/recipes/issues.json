{
  // The next page in the Link header. Only the window's start is used: the API filters on "updated since".
  "name": "github/dotnet-runtime-issues",
  "request": {
    "url": "https://api.github.com/repos/dotnet/runtime/issues",
    "query": { "state": "all", "since": "{{window.start}}", "per_page": "100" },
    "headers": { "Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28" }
  },
  "records": "$",
  "pagination": { "type": "linkHeader" }
}
